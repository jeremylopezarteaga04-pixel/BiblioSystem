python3 - <<'PY'
import sqlite3
from pathlib import Path

carpeta = Path("database")
archivo_sql = carpeta / "BiblioSystem_Base_de_Datos.sql"
archivo_db = carpeta / "bibliosystem.sqlite"
archivo_temporal = carpeta / "bibliosystem_nuevo.sqlite"

contenido = archivo_sql.read_text(encoding="utf-8")

if "AUTO_INCREMENT" in contenido or "ENGINE=InnoDB" in contenido:
    print("ERROR: El archivo SQL todavía corresponde a MySQL.")
    print("Reemplázalo por el SQL incluido en BiblioSystem_SQLite.zip.")
    raise SystemExit(1)

archivo_temporal.unlink(missing_ok=True)

conexion = sqlite3.connect(archivo_temporal)

try:
    conexion.executescript(contenido)
    conexion.commit()
finally:
    conexion.close()

archivo_temporal.replace(archivo_db)

print("Base SQLite creada correctamente.")
PY